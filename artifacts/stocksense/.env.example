# Copy this file to .env and fill in your values.
# In Vercel/Replit, set these as environment variables/Secrets (not in this
# file) so they don't get committed.

# ── Client-visible (safe — Vite inlines VITE_-prefixed vars into public JS) ──
# Google Apps Script Web App URL. Used by the homepage lead form to submit
# leads directly. This is a URL, not a secret, so it's fine client-side.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Not a secret — GTM
# container IDs are meant to be public. Only set this in Vercel's PREVIEW
# environment scope for now (per Milestone 2.2's engineering rules — do not
# touch Production). Leave unset and the container never loads (see
# src/lib/gtm.ts) — no container ID exists yet as of this milestone.
VITE_GTM_CONTAINER_ID=

# TEMPORARY FALLBACK (Milestone 2.4) — set to "true" to force the old
# direct-to-Apps-Script no-cors submission instead of the /api/submit-lead
# proxy. Only use this as a break-glass measure if the proxy has a live
# incident: that path cannot confirm the backend actually saved the lead,
# so lead_submit_success on it does NOT satisfy "conversion only fires on a
# confirmed save." Remove this var (and the code path) once the proxy has
# been validated in production for a full cycle.
VITE_USE_LEGACY_LEAD_SUBMIT=

# ── Server-only (no VITE_ prefix — read only by the /api/admin-* and
#    /api/submit-lead functions, never bundled into client JS) ──────────────
# Same Apps Script Web App URL as above, read server-side by both proxies.
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# The password typed into /admin. Rotate this independently of the value
# below — a leak of one doesn't compromise the other.
ADMIN_PASSWORD=CHANGE_ME_NOW

# Must match the ADMIN_PASSWORD constant configured in google-apps-script/Code.gs.
# This is the token /api/admin-leads.ts uses when calling Apps Script — it
# never reaches the browser.
APPS_SCRIPT_ADMIN_TOKEN=CHANGE_ME_NOW

# ── Removed ──────────────────────────────────────────────────────────────────
# VITE_ADMIN_PASSWORD no longer exists in the code. If it's still set in your
# Vercel/Replit environment from a previous deployment, DELETE it — Vite
# inlines every VITE_-prefixed var into the public JS bundle, which was
# exactly the vulnerability this fixes. Deleting it is required, not optional.
